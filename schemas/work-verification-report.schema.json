{
  "$defs": {
    "CommandVerification": {
      "additionalProperties": false,
      "properties": {
        "claimed_exit_code": {
          "maximum": 255,
          "minimum": -1,
          "title": "Claimed Exit Code",
          "type": "integer"
        },
        "command_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Hash",
          "type": "string"
        },
        "reason": {
          "default": "Restork Work V1 never executes commands.",
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "unverified"
        }
      },
      "required": [
        "command_hash",
        "claimed_exit_code"
      ],
      "title": "CommandVerification",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "matched",
        "mismatched",
        "unverified"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "FileVerification": {
      "additionalProperties": false,
      "properties": {
        "expected_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Hash"
        },
        "observed_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Hash"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        }
      },
      "required": [
        "relative_path",
        "status",
        "reason"
      ],
      "title": "FileVerification",
      "type": "object"
    },
    "VerificationStatus": {
      "enum": [
        "verified",
        "partial",
        "failed"
      ],
      "title": "VerificationStatus",
      "type": "string"
    },
    "WorkTaskUpdatePreview": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "mark_complete",
          "default": "mark_complete",
          "title": "Action",
          "type": "string"
        },
        "apply_available": {
          "const": false,
          "default": false,
          "title": "Apply Available",
          "type": "boolean"
        },
        "evidence_ref": {
          "pattern": "^work-verification-[0-9a-f]{24}$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "suggested_markdown": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Suggested Markdown",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "suggested_markdown",
        "evidence_ref"
      ],
      "title": "WorkTaskUpdatePreview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/FileVerification"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "changed_files": {
      "items": {
        "$ref": "#/$defs/FileVerification"
      },
      "title": "Changed Files",
      "type": "array"
    },
    "commands": {
      "items": {
        "$ref": "#/$defs/CommandVerification"
      },
      "title": "Commands",
      "type": "array"
    },
    "completion_eligible": {
      "title": "Completion Eligible",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/VerificationStatus"
    },
    "task_update_preview": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkTaskUpdatePreview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unexpected_changes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unexpected Changes",
      "type": "array"
    },
    "verification_id": {
      "pattern": "^work-verification-[0-9a-f]{24}$",
      "title": "Verification Id",
      "type": "string"
    }
  },
  "required": [
    "verification_id",
    "run_id",
    "manifest_hash",
    "status",
    "changed_files",
    "artifacts",
    "commands",
    "completion_eligible",
    "created_at"
  ],
  "title": "WorkVerificationReport",
  "type": "object"
}
