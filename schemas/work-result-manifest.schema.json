{
  "$defs": {
    "ChangedFileClaim": {
      "additionalProperties": false,
      "properties": {
        "after_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Hash"
        },
        "before_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Hash"
        },
        "relative_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "relative_path"
      ],
      "title": "ChangedFileClaim",
      "type": "object"
    },
    "ClaimedCommand": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "exit_code": {
          "maximum": 255,
          "minimum": -1,
          "title": "Exit Code",
          "type": "integer"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "command",
        "exit_code"
      ],
      "title": "ClaimedCommand",
      "type": "object"
    },
    "ResultArtifactClaim": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "content_hash"
      ],
      "title": "ResultArtifactClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResultArtifactClaim"
      },
      "maxItems": 50,
      "title": "Artifacts",
      "type": "array"
    },
    "base_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Snapshot Hash",
      "type": "string"
    },
    "changed_files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ChangedFileClaim"
      },
      "maxItems": 100,
      "title": "Changed Files",
      "type": "array"
    },
    "claimed_commands": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ClaimedCommand"
      },
      "maxItems": 50,
      "title": "Claimed Commands",
      "type": "array"
    },
    "plan_artifact_id": {
      "pattern": "^work-plan-[0-9a-f]{24}$",
      "title": "Plan Artifact Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "summary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "plan_artifact_id",
    "base_snapshot_hash",
    "summary"
  ],
  "title": "WorkResultManifest",
  "type": "object"
}
