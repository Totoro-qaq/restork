{
  "additionalProperties": false,
  "properties": {
    "applied": {
      "default": true,
      "title": "Applied",
      "type": "boolean"
    },
    "approval_id": {
      "minLength": 1,
      "title": "Approval Id",
      "type": "string"
    },
    "artifact_ref": {
      "pattern": "^work-handoffs/[a-z0-9-]+\\.json$",
      "title": "Artifact Ref",
      "type": "string"
    },
    "byte_count": {
      "maximum": 2000000,
      "minimum": 1,
      "title": "Byte Count",
      "type": "integer"
    },
    "exported_at": {
      "format": "date-time",
      "title": "Exported At",
      "type": "string"
    },
    "package_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Package Hash",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "approval_id",
    "artifact_ref",
    "package_hash",
    "byte_count",
    "exported_at"
  ],
  "title": "WorkExportResult",
  "type": "object"
}
