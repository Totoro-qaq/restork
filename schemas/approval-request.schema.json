{
  "$defs": {
    "ApprovalDecision": {
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired",
        "consumed"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "RiskClass": {
      "enum": [
        "read_only",
        "local_write",
        "external_action",
        "high_impact"
      ],
      "title": "RiskClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_digest": {
      "minLength": 1,
      "title": "Action Digest",
      "type": "string"
    },
    "action_kind": {
      "minLength": 1,
      "title": "Action Kind",
      "type": "string"
    },
    "approval_id": {
      "minLength": 1,
      "title": "Approval Id",
      "type": "string"
    },
    "canonical_scope": {
      "minLength": 1,
      "title": "Canonical Scope",
      "type": "string"
    },
    "consumed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consumed At"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided By"
    },
    "decision": {
      "$ref": "#/$defs/ApprovalDecision",
      "default": "pending"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "human_summary": {
      "minLength": 1,
      "title": "Human Summary",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "nonce": {
      "minLength": 1,
      "title": "Nonce",
      "type": "string"
    },
    "policy_version": {
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "preview_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Ref"
    },
    "resource_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Resource Versions",
      "type": "object"
    },
    "risk_class": {
      "$ref": "#/$defs/RiskClass"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "approval_id",
    "run_id",
    "action_kind",
    "risk_class",
    "human_summary",
    "action_digest",
    "canonical_scope",
    "policy_version",
    "idempotency_key",
    "nonce",
    "expires_at"
  ],
  "title": "ApprovalRequest",
  "type": "object"
}
