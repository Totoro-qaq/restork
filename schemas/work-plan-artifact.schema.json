{
  "$defs": {
    "DataClass": {
      "enum": [
        "public",
        "personal",
        "confidential",
        "secret",
        "credential"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "WorkFileSnapshot": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "maximum": 500000,
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "data_class": {
          "$ref": "#/$defs/DataClass"
        },
        "exists_at_plan": {
          "default": true,
          "title": "Exists At Plan",
          "type": "boolean"
        },
        "included_in_handoff": {
          "title": "Included In Handoff",
          "type": "boolean"
        },
        "language": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "redactions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Redactions",
          "type": "array"
        },
        "relative_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "byte_count",
        "language",
        "data_class",
        "included_in_handoff"
      ],
      "title": "WorkFileSnapshot",
      "type": "object"
    },
    "WorkPlanStep": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "order": {
          "maximum": 100,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "step_id": {
          "pattern": "^work-step-[0-9a-f]{24}$",
          "title": "Step Id",
          "type": "string"
        },
        "target_files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Target Files",
          "type": "array"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "verification": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Verification",
          "type": "array"
        }
      },
      "required": [
        "step_id",
        "order",
        "title",
        "intent"
      ],
      "title": "WorkPlanStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^work-plan-[0-9a-f]{24}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "completion_criteria": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Completion Criteria",
      "type": "array"
    },
    "constraints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Constraints",
      "type": "array"
    },
    "context_manifest": {
      "items": {
        "$ref": "#/$defs/WorkFileSnapshot"
      },
      "maxItems": 80,
      "title": "Context Manifest",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "goal": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "instruction_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Instruction Refs",
      "type": "array"
    },
    "non_goals": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Non Goals",
      "type": "array"
    },
    "plan_steps": {
      "items": {
        "$ref": "#/$defs/WorkPlanStep"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Plan Steps",
      "type": "array"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_summary": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Scope Summary",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/DataClass"
    },
    "target_files": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Target Files",
      "type": "array"
    },
    "validation_status": {
      "const": "valid",
      "default": "valid",
      "title": "Validation Status",
      "type": "string"
    },
    "verification_commands": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Verification Commands",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Warnings",
      "type": "array"
    },
    "workspace_id": {
      "pattern": "^workspace-[0-9a-f]{24}$",
      "title": "Workspace Id",
      "type": "string"
    },
    "workspace_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workspace Snapshot Hash",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "run_id",
    "request_hash",
    "workspace_id",
    "workspace_snapshot_hash",
    "goal",
    "scope_summary",
    "target_files",
    "context_manifest",
    "completion_criteria",
    "plan_steps",
    "sensitivity",
    "created_at"
  ],
  "title": "WorkPlanArtifact",
  "type": "object"
}
