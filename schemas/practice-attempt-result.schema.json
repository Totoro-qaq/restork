{
  "$defs": {
    "ReviewAction": {
      "enum": [
        "retry_with_hint",
        "spaced_review"
      ],
      "title": "ReviewAction",
      "type": "string"
    },
    "ReviewPlan": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ReviewAction"
        },
        "due_at": {
          "format": "date-time",
          "title": "Due At",
          "type": "string"
        },
        "interval_days": {
          "maximum": 365,
          "minimum": 0,
          "title": "Interval Days",
          "type": "integer"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "action",
        "due_at",
        "interval_days",
        "reason"
      ],
      "title": "ReviewPlan",
      "type": "object"
    },
    "StudyRecordPreview": {
      "additionalProperties": false,
      "properties": {
        "apply_available": {
          "default": false,
          "title": "Apply Available",
          "type": "boolean"
        },
        "attempt_count": {
          "minimum": 2,
          "title": "Attempt Count",
          "type": "integer"
        },
        "markdown": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Markdown",
          "type": "string"
        },
        "markdown_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Markdown Hash",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "markdown",
        "markdown_hash",
        "attempt_count"
      ],
      "title": "StudyRecordPreview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_count": {
      "minimum": 1,
      "title": "Attempt Count",
      "type": "integer"
    },
    "attempt_id": {
      "pattern": "^attempt-[0-9a-f]{24}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "correct": {
      "title": "Correct",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error_count": {
      "minimum": 0,
      "title": "Error Count",
      "type": "integer"
    },
    "exercise_id": {
      "pattern": "^exercise-[0-9a-f]{24}$",
      "title": "Exercise Id",
      "type": "string"
    },
    "feedback": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Feedback",
      "type": "string"
    },
    "next_review": {
      "$ref": "#/$defs/ReviewPlan"
    },
    "record_preview": {
      "anyOf": [
        {
          "$ref": "#/$defs/StudyRecordPreview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "attempt_id",
    "run_id",
    "exercise_id",
    "correct",
    "feedback",
    "error_count",
    "attempt_count",
    "next_review",
    "created_at"
  ],
  "title": "PracticeAttemptResult",
  "type": "object"
}
