{
  "$defs": {
    "DataClass": {
      "enum": [
        "public",
        "personal",
        "confidential",
        "secret",
        "credential"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "LearningObjective": {
      "additionalProperties": false,
      "properties": {
        "objective_id": {
          "pattern": "^objective-[0-9a-f]{24}$",
          "title": "Objective Id",
          "type": "string"
        },
        "outcome": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Success Criteria",
          "type": "array"
        }
      },
      "required": [
        "objective_id",
        "outcome",
        "success_criteria"
      ],
      "title": "LearningObjective",
      "type": "object"
    },
    "LearningStep": {
      "additionalProperties": false,
      "properties": {
        "note_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Note Refs",
          "type": "array"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "outcome": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "step_id": {
          "pattern": "^learning-step-[0-9a-f]{24}$",
          "title": "Step Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "order",
        "title",
        "outcome"
      ],
      "title": "LearningStep",
      "type": "object"
    },
    "PracticeExercise": {
      "additionalProperties": false,
      "properties": {
        "answer_revealed": {
          "const": false,
          "default": false,
          "title": "Answer Revealed",
          "type": "boolean"
        },
        "concept": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "exercise_id": {
          "pattern": "^exercise-[0-9a-f]{24}$",
          "title": "Exercise Id",
          "type": "string"
        },
        "hints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Hints",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/PracticeKind"
        },
        "prompt": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "exercise_id",
        "concept",
        "kind",
        "prompt"
      ],
      "title": "PracticeExercise",
      "type": "object"
    },
    "PracticeKind": {
      "enum": [
        "active_recall",
        "application"
      ],
      "title": "PracticeKind",
      "type": "string"
    },
    "StudyMetrics": {
      "additionalProperties": false,
      "properties": {
        "diagnostic_completed": {
          "const": true,
          "default": true,
          "title": "Diagnostic Completed",
          "type": "boolean"
        },
        "explicit_prerequisite_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Explicit Prerequisite Ratio",
          "type": "number"
        },
        "practice_count": {
          "minimum": 1,
          "title": "Practice Count",
          "type": "integer"
        },
        "related_note_count": {
          "minimum": 0,
          "title": "Related Note Count",
          "type": "integer"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "explicit_prerequisite_ratio",
        "practice_count",
        "related_note_count"
      ],
      "title": "StudyMetrics",
      "type": "object"
    },
    "StudyPrerequisite": {
      "additionalProperties": false,
      "properties": {
        "explicit_source": {
          "const": "prerequisite_section",
          "default": "prerequisite_section",
          "title": "Explicit Source",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "title",
        "rationale"
      ],
      "title": "StudyPrerequisite",
      "type": "object"
    },
    "StudyRelatedNote": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "title"
      ],
      "title": "StudyRelatedNote",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^study-[0-9a-f]{24}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "diagnostic_ref": {
      "pattern": "^study-diagnostic-[0-9a-f]{24}$",
      "title": "Diagnostic Ref",
      "type": "string"
    },
    "exercises": {
      "items": {
        "$ref": "#/$defs/PracticeExercise"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Exercises",
      "type": "array"
    },
    "learning_path": {
      "items": {
        "$ref": "#/$defs/LearningStep"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Learning Path",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/StudyMetrics"
    },
    "objective": {
      "$ref": "#/$defs/LearningObjective"
    },
    "prerequisites": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StudyPrerequisite"
      },
      "title": "Prerequisites",
      "type": "array"
    },
    "readiness_signal": {
      "enum": [
        "foundation",
        "developing",
        "ready"
      ],
      "title": "Readiness Signal",
      "type": "string"
    },
    "related_notes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StudyRelatedNote"
      },
      "title": "Related Notes",
      "type": "array"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sensitivity": {
      "$ref": "#/$defs/DataClass"
    },
    "validation_status": {
      "const": "valid",
      "default": "valid",
      "title": "Validation Status",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "run_id",
    "request_hash",
    "diagnostic_ref",
    "readiness_signal",
    "objective",
    "learning_path",
    "exercises",
    "metrics",
    "sensitivity",
    "created_at"
  ],
  "title": "StudyArtifact",
  "type": "object"
}
