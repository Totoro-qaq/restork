{
  "$defs": {
    "DiagnosticQuestion": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "question_id": {
          "pattern": "^diagnostic-[0-9a-f]{24}$",
          "title": "Question Id",
          "type": "string"
        },
        "response_kind": {
          "$ref": "#/$defs/DiagnosticResponseKind"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "response_kind"
      ],
      "title": "DiagnosticQuestion",
      "type": "object"
    },
    "DiagnosticResponseKind": {
      "enum": [
        "rating",
        "free_text"
      ],
      "title": "DiagnosticResponseKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "diagnostic_id": {
      "pattern": "^study-diagnostic-[0-9a-f]{24}$",
      "title": "Diagnostic Id",
      "type": "string"
    },
    "objective": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/DiagnosticQuestion"
      },
      "maxItems": 8,
      "minItems": 2,
      "title": "Questions",
      "type": "array"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_snapshot_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Snapshot Hash"
    }
  },
  "required": [
    "diagnostic_id",
    "run_id",
    "request_hash",
    "objective",
    "questions",
    "created_at"
  ],
  "title": "StudyDiagnostic",
  "type": "object"
}
