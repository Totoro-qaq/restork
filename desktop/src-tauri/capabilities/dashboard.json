{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard-capability",
  "description": "The exact Restork loopback Dashboard may exchange only its short-lived browser session.",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "allow-desktop-session",
    "allow-desktop-store-session",
    "allow-desktop-vault-config",
    "allow-desktop-choose-vault",
    "allow-desktop-apply-vault",
    "allow-desktop-configure-provider-secret",
    "allow-desktop-onboarding-state",
    "allow-desktop-set-onboarding-dismissed",
    "allow-desktop-update-recovery"
  ]
}
